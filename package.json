{
  "name": "dsh-video-storyboard",
  "version": "0.7.0",
  "description": "视频读取：把一段视频压成一张可寻址的分镜图 + 一份带时间码的文本清单（video_storyboard / video_zoom / video_probe / video_locate / video_watch）。ffmpeg/ffprobe 不随仓库分发，需自备或运行 scripts/fetch-ffmpeg.mjs。基于 SAOS-3624/dsh-video-storyboard（MIT）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "storyboard",
    "contact-sheet",
    "ffmpeg",
    "multimodal",
    "asr"
  ],
  "homepage": "https://github.com/SAOS-3624/dsh-video-storyboard#readme",
  "bugs": {
    "url": "https://github.com/SAOS-3624/dsh-video-storyboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAOS-3624/dsh-video-storyboard.git"
  },
  "author": "SAOS-3624",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./plan": "./src/plan.js",
    "./scan": "./src/scan.js",
    "./segments": "./src/segments.js",
    "./probe": "./src/probe.js",
    "./sheet": "./src/sheet.js",
    "./pipeline": "./src/pipeline.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "bin": {
    "dsh-video-scan": "./bin/scan-video.mjs",
    "dsh-video-storyboard": "./bin/storyboard.mjs"
  },
  "files": [
    "src",
    "bin",
    "scripts",
    "docs",
    "vendor",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "CREDITS.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test",
    "check": "node scripts/check-syntax.mjs",
    "smoke": "node scripts/smoke.mjs",
    "fetch-ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "sim": "node scripts/watch-sim.mjs",
    "e2e": "node scripts/watch-e2e.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
